          function toggleSaturdays() {
        const saturdayWeekend = $("#saturdayWeekend").prop("checked");
        const holidaysArray = $("#holidayData").val() ? JSON.parse($("#holidayData").val()) : [];

        $(".calendar-month td").each(function () {
            if ($(this).text().trim() !== "") {
                const date = $(this).data("date");
                const dayOfWeek = new Date(date).getUTCDay();

                if (dayOfWeek === 6) { // If it's a Saturday
                    const holidayExists = holidaysArray.some(h => h.Date === date);

                    if (saturdayWeekend) {
                        $(this).addClass("disabled").removeClass("clickable").off("click");
                        if (holidayExists) {
                            $(this).addClass("holiday").css("background-color", "#ffeb3b");
                        }
                    } else {
                        $(this).removeClass("disabled").addClass("clickable");

                        if (!$(this).attr("data-click-bound")) {
                            $(this).attr("data-click-bound", "true");
                            $(this).on("click", function () {
                                selectDate($(this).data("date"));
                            });
                        }

                        if (holidayExists) {
                            $(this).addClass("holiday").css("background-color", "#ffeb3b");
                        }
                    }
                }
            }
        });
    }


    function generateCalendar(year, holidays) {
        const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
        const calendarContainer = $("#calendarContainer");
        calendarContainer.html("");

        months.forEach((month, index) => {
            const calendar = $("<div>").addClass("calendar-month").append(`<h3>${month} ${year}</h3>`);
            const table = $("<table>").html(`
                <tr>
                    <th>Sun</th><th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th>
                </tr>
            `);

            const firstDay = new Date(year, index, 1).getDay();
            const daysInMonth = new Date(year, index + 1, 0).getDate();

            let row = "<tr>";
            for (let i = 0; i < firstDay; i++) {
                row += "<td></td>";
            }

            for (let day = 1; day <= daysInMonth; day++) {
                const date = new Date(Date.UTC(year, index, day));
                const holidayDate = date.toISOString().split("T")[0];

                const holiday = holidays.find(h => {
                    const dbDate = new Date(h.date);
                    const formattedDate = dbDate.toISOString().split("T")[0];
                    return formattedDate === holidayDate;
                });

                let cellClass = "clickable";
                let cellClick = `onclick="selectDate('${holidayDate}')"`;

                if (disabledDays.includes(date.getUTCDay())) {
                    cellClass = "disabled";
                    cellClick = "";
                }
                if (holiday) {
                    cellClass += " holiday";
                }

                row += `<td class="${cellClass}" data-date="${holidayDate}" ${cellClick}>${day}</td>`;

                if ((day + firstDay) % 7 === 0 || day === daysInMonth) {
                    row += "</tr>";
                    table.append(row);
                    row = "<tr>";
                }
            }

            calendar.append(table);
            calendarContainer.append(calendar);
        });
    }

  

        function selectDate(date) {
        console.log("Selected Date:", date);

        let holidaysArray = $("#holidayData").val() ? JSON.parse($("#holidayData").val()) : [];
        let country = $("#country").val();

       
        if (holidaysArray.some(h => h.Date === date && h.Country === country)) {
            alert("This holiday is already added!");
            return;
        }

        let holidayName = prompt("Enter holiday name for " + date + ":");
        if (!holidayName) return;

        $("#selectedDate").val(date);

       
        holidaysArray.push({ Date: date, Name: holidayName, Country: country });
        $("#holidayData").val(JSON.stringify(holidaysArray));

        console.log("Updated Holiday Data:", holidaysArray);

        $("#manuallyAddedHolidays").append(`<li data-date="${date}">${date} - ${holidayName}</li>`);
        updateCalendarHighlight(date);
    }


        $("#selectedDate").on("change", function () {
        selectedDate = $(this).val();
        console.log("Date Selected:", selectedDate);
    });


        $("#confirmHoliday").on("click", function () {
        let holidayName = $("#holidayName").val();
        let country = $("#holidayCountry").val();

        if (!$("#selectedDate").val() || !holidayName) {
            alert("Please select a date and enter a holiday name!");
            return;
        }

        let newHoliday = {
            Date: $("#selectedDate").val(),
            Name: holidayName,
            Country: country
        };

        
        let holidaysArray = $("#holidayData").val() ? JSON.parse($("#holidayData").val()) : [];
        holidaysArray.push(newHoliday);
        $("#holidayData").val(JSON.stringify(holidaysArray)); 

        console.log("Holiday Added:", newHoliday);

        alert("Holiday added: " + newHoliday.Date + " - " + holidayName);
    });



          $(document).ready(function () {
        $("#submitHolidays").off("click").on("click", function (event) {
            event.preventDefault();

            let holidayData = $("#holidayData").val().trim();
            if (!holidayData || holidayData === "[]") {
                alert("Please select at least one holiday.");
                return;
            }

            let holidaysArray = JSON.parse(holidayData);

           
            let antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: "/DHolidayCalender/DIndex?handler=AddHoliday",
                type: "POST",
                contentType: "application/json",
                dataType: "json",
                data: JSON.stringify(holidaysArray),
                headers: {
                    "RequestVerificationToken": antiForgeryToken
                },
                success: function (response) {
                    alert("Holiday(s) added successfully!");
                    location.reload();
                },
                error: function (xhr) {
                    alert("Error: " + xhr.status + " - " + xhr.responseText);
                }
            });
        });
    });





          function deleteHoliday(date) {
        if (!confirm(`Are you sure you want to delete the holiday on ${date}?`)) {
            return;
        }

        let country = $("#country").val();
        let holidayRow = $(`#holidayList tr`).filter(function () {
            return $(this).find("td:first").text().trim() === date;
        });

        let holidayName = holidayRow.find("td:nth-child(2)").text().trim();
        if (!holidayName) {
            alert("Error: Holiday name not found! Please check the table.");
            return;
        }

       
        let utcDate = new Date(date + "T00:00:00Z").toISOString().split("T")[0];

        let token = $('input[name="__RequestVerificationToken"]').val();

        console.log("🛠 Sending Payload:", JSON.stringify({
            Date: utcDate,
            Country: country,
            Name: holidayName
        }));

        $.ajax({
            url: "/DHolidayCalender/DIndex?handler=DeleteHoliday",
            type: "POST",
            contentType: "application/json",
            dataType: "json",
            headers: { "RequestVerificationToken": token },
            data: JSON.stringify({
                Date: utcDate,
                Country: country,
                Name: holidayName
            }),
            success: function (response) {
                if (response.success) {
                    holidayRow.remove();
                    alert("✅ Holiday deleted successfully!");
                } else {
                    alert("❌ Failed to delete the holiday: " + response.message);
                }
            },
            error: function (xhr) {
                console.error("❌ Error:", xhr.status, xhr.responseText);
                alert("❌ Error: " + xhr.status + " - " + xhr.responseText);
            }
        });
    }




         function updateCalendarHighlight(selectedDate) {
        $(".calendar-month td").each(function () {
            if ($(this).data("date") === selectedDate) {
                $(this).addClass("holiday").removeClass("clickable");
            }
        });
    }


           function keepCalendarVisible(event) {
        event.preventDefault(); 

         $("#selectedDate").val("");

    alert("Form submitted! Calendar remains visible.");

    }


        function saveHoliday(date) {
        let holidaysArray = JSON.parse(localStorage.getItem("holidays")) || [];
        if (!holidaysArray.includes(date)) {
            holidaysArray.push(date);
            localStorage.setItem("holidays", JSON.stringify(holidaysArray));
        }
    }

        function restoreHolidays() {
        let holidaysArray = JSON.parse(localStorage.getItem("holidays")) || [];

        $(".calendar-month td").each(function () {
            const date = $(this).data("date");
            if (holidaysArray.includes(date)) {
                $(this).addClass("holiday");
            }
        });
    }

        $(document).ready(function () {
        restoreHolidays();
    });

</script>


  



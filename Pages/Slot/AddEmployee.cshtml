@page
@model MYChamp.Pages.Slot.AddEmployeeModel

<h2 class="mb-3 text-center">Add Slot</h2>

<form method="post" class="w-50 mx-auto">
    <div class="mb-3"><strong>Name:</strong> @Model._register.FirstName @Model._register.LastName</div>
    <div class="mb-3"><strong>Job Title:</strong> @Model._register.JobTitle</div>
    <div class="mb-3"><strong>Email:</strong> @Model._register.EmailId</div>
    <div class="mb-3"><strong>Phone:</strong> @Model._register.PhoneNumber</div>

    <div class="mb-3">
        <label class="form-label">Slot Date</label>
        <input type="date" class="form-control" id="slotDate" asp-for="SlotDate" required />
        <span asp-validation-for="SlotDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Slot Start</label>
        <input type="time" class="form-control" asp-for="SlotStart" required />
        <span asp-validation-for="SlotStart" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Slot End</label>
        <input type="time" class="form-control" asp-for="SlotEnd" required />
        <span asp-validation-for="SlotEnd" class="text-danger"></span>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="text-center">
        <button type="submit" class="btn btn-primary">Submit</button>
        <a asp-page="/Slot/EmployeeIndex" class="btn btn-secondary">Cancel</a>
    </div>
</form>

<script>
    window.onload = () => {
        let today = new Date().toISOString().split('T')[0];
        let maxDate = new Date();
        maxDate.setDate(maxDate.getDate() + 2);
        document.getElementById("slotDate").min = today;
        document.getElementById("slotDate").max = maxDate.toISOString().split('T')[0];
    };
</script>
